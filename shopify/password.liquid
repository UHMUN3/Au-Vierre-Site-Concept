<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} - COMING SOON</title>

<link rel="icon" href="{{ 'favicon.ico' | asset_url }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}">
<link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16x16.png' | asset_url }}">

<link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">

<link rel="icon" type="image/png" sizes="192x192" href="{{ 'android-chrome-192x192.png' | asset_url }}">
<link rel="icon" type="image/png" sizes="512x512" href="{{ 'android-chrome-512x512.png' | asset_url }}">

<link rel="manifest" href="{{ 'site.webmanifest' | asset_url }}">

    {{ content_for_header }}

    <style>
      @font-face {
        font-family: 'WBTextt';
        src: url("{{ 'WBTextt.otf' | asset_url }}");
        font-weight: normal;
        font-style: normal;
      }

      body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        background: #ffffff;
        color: #000;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        overflow: hidden;
      }

      .password-main-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
        text-align: center;
        padding: 20px;
        box-sizing: border-box;
      }

      .brand-title {
        font-family: 'WBTextt', serif;
        font-size: 6rem; 
        margin: 0 0 10px 0;
        text-transform: uppercase;
        line-height: 1;
        font-weight: normal;
      }

      .form-wrapper {
        width: 100%;
        max-width: 380px;
        display: flex;
        flex-direction: column;
        gap: 15px; /* Matches contact form gap  */
      }

      input {
        width: 100%;
        padding: 12px; /* Matches contact form padding  */
        border: 1px solid #000;
        background: transparent;
        font-family: 'WBTextt', serif; /* Matches brand typography  */
        font-size: 15px;
        letter-spacing: 0.05em;
        outline: none;
        box-sizing: border-box;
        text-align: left; /* Matches contact form alignment  */
        border-radius: 0; 
        -webkit-appearance: none;
      }

      input::placeholder {
        color: #000;
        text-transform: uppercase;
      }

      button.submit-btn {
        width: 100%;
        padding: 15px;
        background: #000;
        color: #fff;
        border: 1px solid #000;
        font-family: 'WBTextt', serif;
        font-size: 14px; /* Matches shop add-btn [cite: 53] */
        letter-spacing: 0.15em;
        cursor: pointer;
        text-transform: uppercase;
        transition: background 0.3s ease;
      }

      button.submit-btn:hover {
        background: #333;
        border-color: #333;
      }

      .toggle-link {
        margin-top: 25px;
        font-size: 10px;
        text-decoration: underline;
        cursor: pointer;
        letter-spacing: 0.1em;
        background: none;
        border: none;
        padding: 0;
        color: #666;
        text-transform: uppercase;
      }
      
      .message-status {
        font-family: 'WBTextt', serif;
        font-size: 11px;
        margin-bottom: 20px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .hidden { display: none !important; }

      @media (max-width: 768px) {
        .brand-title { font-size: 15vw; }
      }
    </style>
  </head>

  <body>
    <main id="MainContent" class="password-main-content">
      <h1 class="brand-title">AU VIERRE</h1>

   <div id="signup-section" class="form-wrapper">
  {% form 'customer' %}
    {% if form.posted_successfully? %}
      <p class="message-status">YOU ARE ON THE LIST.</p>
    {% else %}
      {% if form.errors %}
         <p class="message-status" style="color: red;">{{ form.errors | default_errors }}</p>
      {% endif %}
      
      <p style="font-family: 'WBTextt', serif; font-size: 25px; margin-bottom: 5px; letter-spacing: 0.1em; text-transform: uppercase; color: #000;">
        JOIN TO GET EXCLUSIVE UPDATES!
      </p>

      <div style="display: flex; flex-direction: column; gap: 15px;">
        <input type="hidden" name="contact[tags]" value="newsletter, waiting_list">
        <input type="email" name="contact[email]" id="Email" placeholder="ENTER EMAIL" required>
        <button type="submit" class="submit-btn">NOTIFY ME</button>
      </div>
    {% endif %}
  {% endform %}
  <button class="toggle-link" onclick="toggleView('password')">ENTER WITH PASSWORD</button>
</div>

      <div id="password-section" class="form-wrapper hidden">
        {% form 'storefront_password' %}
          {% if form.errors %}
             <p class="message-status" style="color: red;">INCORRECT PASSWORD</p>
          {% endif %}
          <div style="display: flex; flex-direction: column; gap: 15px;">
            <input type="password" name="password" id="Password" placeholder="ENTER PASSWORD">
            <button type="submit" class="submit-btn">ENTER</button>
          </div>
        {% endform %}
        <button class="toggle-link" onclick="toggleView('signup')">BACK TO SIGN UP</button>
      </div>
 </main>

    <div style="display: none !important;">
      {{ content_for_layout }}
    </div>

    <script>
      function toggleView(view) {
        const signup = document.getElementById('signup-section');
        const pass = document.getElementById('password-section');
        if (view === 'password') {
          signup.classList.add('hidden');
          pass.classList.remove('hidden');
        } else {
          pass.classList.add('hidden');
          signup.classList.remove('hidden');
        }
      }
      if(window.location.hash === '#login') toggleView('password');
    </script>
  </body>
</html>